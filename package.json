{
  "name": "rcp-front",
  "private": true,
  "version": "0.1.0",
  "description": "RCP frontend MVP aligned to rcp-front/PRD.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/create-spa-fallback.mjs",
    "preview": "vite preview",
    "serve": "node server.mjs",
    "test": "node --test server.test.mjs src/services/*.test.ts src/components/landing/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "check:fix": "biome check --write"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
